# ==============================================================================
# CloudQueue Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Operation Mode: 'local' (SQLite queue) or 'gcp' (Google Cloud Pub/Sub queue)
CLOUDQUEUE_MODE=local

# General Environment: 'development', 'production', 'test'
CLOUDQUEUE_ENV=development

# Database Path (Stores job results, experiment metadata, and local queue)
DATABASE_PATH=database/cloudqueue.db

# Google Cloud Platform Settings (Required only when CLOUDQUEUE_MODE=gcp)
# Example: GOOGLE_CLOUD_PROJECT=my-cloud-project-12345
GOOGLE_CLOUD_PROJECT=
PUBSUB_TOPIC=cloudqueue-jobs
PUBSUB_SUBSCRIPTION=cloudqueue-worker-sub

# Web Server Port
PORT=5000
